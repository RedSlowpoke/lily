;;; probe-spacer.scm: springs and spring-rod problems (MS3 step 29)
;; Calls of spring-smob.cc's and simple-spacer-scheme.cc's ly: functions,
;; run in (lily): by LilyPond 2.26.0 (tools/compare/spacer-calls.ly), and
;; by the engine from source with the library natively, and from the image
;; natively and in wasm (tools/bench/test/spacer.test.mjs), which compares
;; them to four decimals. The calls reach the springs' smob (ly:make-spring,
;; ly:spring?, the inverse strengths' setters, its printer and equality)
;; and Simple_spacer through ly:solve-spring-rod-problem: its springs and
;; rods, solve with its force, the configuration's positions and whether it
;; fits, ragged or not. merge_springs, operator*=, set_blocking_force, Rod,
;; Spaceable_grob and Column_x_positions have no Scheme face in 2.26.0 and
;; are not here; crates/layout/tests/spacer.rs checks them.
;; No call here makes LilyPond print a programming error (an insane spring,
;; an infinite rod), crash (a rod not a list of three: SIGSEGV) or read
;; past its springs (a rod past the last spring: its answers change from
;; run to run); tests/spacer.rs checks those as the engine gives them.
;;
;; For each call one line: the numbers, booleans and other values of its
;; value, flattened, as `write` writes them and separated by spaces; or
;; `error`, the error's key and its text as print-exception prints it.
(set-current-module (resolve-module '(lily)))
(define (probe-flat x)
  (cond ((pair? x) (append (probe-flat (car x)) (probe-flat (cdr x))))
        ((null? x) '())
        (else (list x))))
;; An error's text as Guile's print-exception prints a scm-error's, which
;; the engine has as Rust only: `In procedure subr: ` and the message.
(define (probe-error args)
  (let ((subr (car args)) (message (cadr args)) (items (caddr args)))
    (string-append (if subr (simple-format #f "In procedure ~A: " subr) "")
                   (apply simple-format #f message (if (list? items) items '())))))
(define (probe-run call)
  (catch #t
    (lambda ()
      (let loop ((values (probe-flat (primitive-eval call))) (first #t))
        (if (pair? values)
            (begin (if (not first) (display " "))
                   (write (car values))
                   (loop (cdr values) #f)))))
    (lambda (key . args)
      (display "error ")
      (display key)
      (display " ")
      (display (probe-error args))))
  (newline))

