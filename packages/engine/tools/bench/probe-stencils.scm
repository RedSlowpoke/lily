(map ly:transform->list (list (ly:make-rotation 30) (ly:make-rotation 90 '(1 . 2)) (ly:make-rotation 45 '(1 . 1)) (ly:make-rotation -60 '(1/3 . -2)) (ly:make-rotation 180)))
(map ly:transform->list (list (ly:make-translation 1 2) (ly:make-translation '(3 . 4)) (ly:make-translation 1+2i) (ly:make-translation 5)))
(list ((ly:make-rotation 90) '(1 . 0)) ((ly:make-rotation 30 '(1 . 1)) 2+1i) ((ly:make-translation 1 2) 3) ((ly:make-scaling 2 3) '(1 . 1)) ((ly:make-rotation 30) 1))
(map ly:transform->list (list ((ly:make-rotation 30) (ly:make-translation 1 2)) ((ly:make-scaling 2 3) (ly:make-rotation 45 '(1 . 0))) ((ly:make-transform 1 2 3 4 5 6) (ly:make-transform 6 5 4 3 2 1))))
((ly:make-scaling 2) 'x)
((ly:make-scaling 2) '(1 . a))
