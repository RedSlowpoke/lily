(ly:make-stencil "" '(1/2 . 3))
(ly:make-stencil 'a '(1 . 2) 3)
(ly:make-stencil "" '(1 . 2) '(3 . a))
(ly:make-stencil '(foo 1))
(list (ly:stencil? probe-a) (ly:stencil? 1) (ly:transform? (ly:make-transform)) (ly:transform? probe-a) (procedure? (ly:make-transform)))
(list (and (memq 'translate-stencil (ly:all-stencil-expressions)) #t) (and (memq 'draw-line (ly:all-stencil-expressions)) #t) (object-property 'combine-stencil 'stencil-head?))
(ly:register-stencil-expression "x")
;; extents, expressions, emptiness
