(ly:directed 45 'b)
(map (lambda (v) (ly:angle (car v) (cdr v))) '((1 . 0) (1 . 1) (3 . -4) (0 . 0) (-1 . 0) (1 . 2) (-2 . 1) (0.1 . -3) (-1 . -1) (-3 . -1) (2 . -1) (-1 . 2) (0 . -1) (-1/3 . 1/7)))
(list (ly:angle '(-1 . -1)) (ly:angle '(+inf.0 . 1)) (ly:angle '(+inf.0 . +inf.0)))
(ly:angle 'x)
(ly:angle 1 'y)
(list (ly:length 3 4) (ly:length '(1 . 1)) (ly:length '(1e300 . 1e300)) (ly:length 0 -2))
(ly:length '(a . 1))
;; transforms
(ly:make-transform)
(list (ly:transform->list (ly:make-transform)) (ly:transform->list (ly:make-transform 1 2 3 4)) (ly:transform->list (ly:make-transform 1 2 3 4 5 6)))
(ly:make-transform 1 2 3 4 5 6)
