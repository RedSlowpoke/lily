(ly:stencil-scale probe-e 2 3)
(ly:stencil-scale probe-a 'x)
;; rotations
(ly:stencil-rotate probe-a 90 0 0)
(ly:stencil-rotate probe-b 45 -1 1)
(ly:stencil-rotate probe-b 30 0 0)
(ly:stencil-rotate probe-c -135 1 -1)
(ly:stencil-rotate probe-b 450 0 0)
(ly:stencil-rotate probe-b -200 0.5 0.25)
(ly:stencil-rotate probe-b 1/7 0 0)
(ly:stencil-rotate probe-e 90 0 0)
(ly:stencil-rotate-absolute probe-b 60 1 1)
