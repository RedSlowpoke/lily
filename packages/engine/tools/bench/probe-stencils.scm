;; --- define-markup-commands.scm's commands and stencil.scm's procedures
;; that call the shapes on constant arguments (MS3 step 3), where (lily) has
;; them: crates/layout/tests/stencils.rs' bare VM runs the probe only to
;; here. The layout is an output definition of the line thickness alone.
;; interpret-markup is text-interface.cc's, which the engine has from part
;; 1's step 8; until then the probe gives (lily) LilyPond's interpret_markup
;; of a markup that is no string, the markup's procedure applied to the
;; layout, the properties and its arguments, in LilyPond as in the engine,
;; and gives interpret-markup back at the end.
(define probe-layout (let ((layout (ly:make-output-def))) (ly:output-def-set-variable! layout 'line-thickness 0.1) layout))
(define probe-interpret-markup interpret-markup)
(set! interpret-markup (lambda (layout props m) (apply (car m) layout props (cdr m))))
(define (probe-box x y) (list filled-box-markup x y 0))
(for-each probe-run '(
(filled-box-markup probe-layout '() '(0 . 2) '(-1 . 1) 0.2)
(filled-box-markup probe-layout '() '(-0.3 . 1.8) '(-0.3 . 1.8) 0)
(polygon-markup probe-layout '() '((0 . 0) (2 . 0) (1 . 1.5)))
(polygon-markup probe-layout '(((thickness . 2) (extroversion . 1) (filled . #f))) '((1 . 0) (0.31 . 0.95) (-0.81 . 0.59) (-0.81 . -0.59) (0.31 . -0.95)))
(polygon-markup probe-layout '(((extroversion . -1)) ((thickness . 3))) '((0 . 0) (3 . 0) (3 . 1) (0 . 1)))
(rounded-box-markup probe-layout '() (probe-box '(0 . 3) '(0 . 1)))
(rounded-box-markup probe-layout '(((corner-radius . 0.5) (box-padding . 0.2) (thickness . 2) (font-size . 1))) (probe-box '(-1 . 2) '(-0.5 . 0.5)))
(rounded-box-markup probe-layout '(((corner-radius . 4))) (probe-box '(0 . 0.2) '(0 . 0.1)))
(bracket-markup probe-layout '() (probe-box '(0 . 2) '(-1 . 1)))
(hbracket-markup probe-layout '() (probe-box '(0 . 2) '(-1 . 1)))
(interpret-markup probe-layout '() (make-bracket-markup (make-hbracket-markup (make-filled-box-markup '(0 . 1) '(0 . 1) 0.1))))
(interpret-markup probe-layout '() (make-rounded-box-markup (make-polygon-markup '((0 . 0) (1 . 0) (0 . 1)))))
(rounded-box-stencil probe-c 0.1 0.5 1)
(rounded-box-stencil probe-b 0.2 0.1 0.05)
(bracketify-stencil probe-b 1 0.1 0.25 0.1)
(bracketify-stencil probe-a 0 0.15 -0.3 0)
))
(set! interpret-markup probe-interpret-markup)
