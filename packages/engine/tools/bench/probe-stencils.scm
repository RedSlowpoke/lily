(define probe-h (ly:make-stencil "" '(0 . 3) '(+inf.0 . -inf.0)))
(define probe-v (ly:make-stencil "" '(+inf.0 . -inf.0) '(0 . 2)))
(define probe-back (ly:make-stencil "" '(1 . 0) '(+inf.0 . -inf.0)))
(define probe-e (ly:make-stencil '()))
(for-each probe-run '(
