(ly:stencil-stack probe-e 0 1 probe-a)
(ly:stencil-stack probe-a 0 1 probe-v)
(ly:stencil-stack (ly:stencil-stack probe-a 1 -1 probe-b 0.5) 1 -1 probe-c 0.5 2)
(ly:stencil-stack #f 0 1 probe-a)
(ly:stencil-stack probe-a 0 1 '())
(ly:stencil-stack probe-a 0 1 probe-b 0.5 'x)
(ly:stencil-stack 'x 0 1 probe-b)
;; outlines
(ly:stencil-outline probe-a probe-b)
(ly:stencil-outline probe-a 1)
;; vectors
(map ly:directed (list 0 30 45 90 135 180 -45 -90 -135 -180 225 720.5 -540 1/3))
(list (ly:directed 90 2) (ly:directed 30 '(2 . 3)) (ly:directed '(3 . 4)) (ly:directed '(3 . 4) 10) (ly:directed '(0 . 0)) (ly:directed '(+inf.0 . 1)) (ly:directed '(-1 . -inf.0)) (ly:directed '(1 . 1) '(2 . 1/2)))
(ly:directed 'a)
