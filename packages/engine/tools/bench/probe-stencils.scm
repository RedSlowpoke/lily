(ly:stencil-combine-at-edge '() 1 1 probe-b)
(ly:stencil-combine-at-edge probe-a 0 1 #f)
(ly:stencil-combine-at-edge #f 0 1 #f)
(ly:stencil-combine-at-edge probe-a 0 2 probe-b)
(ly:stencil-combine-at-edge probe-a 2 1 probe-b)
(ly:stencil-combine-at-edge 5 0 1 probe-b)
(ly:stencil-combine-at-edge probe-a 0 1 5)
(ly:stencil-combine-at-edge probe-a 0 1 probe-b 'x)
;; stacking
(ly:stencil-stack probe-a 0 1 probe-b)
(ly:stencil-stack probe-a 0 1 probe-b 0.5)
(ly:stencil-stack probe-a 0 1 probe-b 0.5 3)
(ly:stencil-stack probe-b 1 -1 probe-c 0.2 0.1)
