(ly:stencil-extent probe-a 2)
(ly:stencil-extent probe-a 1.0)
(ly:stencil-extent 5 0)
(ly:stencil-expr "s")
(map ly:stencil-empty? (list probe-a probe-e probe-h probe-v (ly:make-stencil "" '(0 . 0) '(0 . 0)) (ly:make-stencil '() '(0 . 1) '(0 . 1))))
(list (ly:stencil-empty? probe-h 0) (ly:stencil-empty? probe-h 1) (ly:stencil-empty? probe-e 0) (ly:stencil-empty? probe-v 0))
(ly:stencil-empty? probe-a -1)
;; translations
(ly:stencil-translate probe-a '(1 . 2))
(ly:stencil-translate probe-e '(1 . 2))
(ly:stencil-translate probe-h '(1/3 . 2))
(ly:stencil-translate probe-a '(+inf.0 . 10000000))
