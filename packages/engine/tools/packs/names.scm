;; The Unicode names of crates/fonts/src/names.rs (MS4 step 19, W6): what
;; Guile's `char->formal-name` gives, which LilyPond 2.26.0's "no glyph for
;; character" warning names a character by (pango-font.cc), for the blocks a
;; text no pack covers reaches: ASCII and Latin-1, which an Emmentaler string
;; lacks, Hebrew, and the CJK symbols with the kana. Hangul syllables and CJK
;; compatibility ideographs are named by rule in unicode.rs; Guile names no CJK
;; unified ideograph. Written as Rust to the standard output:
;;
;;   guile --no-auto-compile tools/packs/names.scm > crates/fonts/src/names.rs
;;
;; as rustfmt formats it. crates/fonts/tests/names.rs checks the table
;; against the Guile on the PATH, and the file against this script's.
(use-modules (ice-9 unicode) (ice-9 regex) (ice-9 format))

(define blocks '((#x20 . #x7e) (#xa0 . #xff) (#x591 . #x5f4) (#x3000 . #x30ff)))

;; Each written as the character of its position plus one.
(define prefixes
  '("LATIN CAPITAL LETTER " "LATIN SMALL LETTER " "HEBREW ACCENT "
    "HEBREW LETTER " "HEBREW POINT " "HEBREW " "HIRAGANA LETTER SMALL "
    "HIRAGANA LETTER " "KATAKANA LETTER SMALL " "KATAKANA LETTER "
    "KATAKANA-HIRAGANA " "IDEOGRAPHIC " " WITH "))

(define (packed name)
  (let loop ((name name) (ps prefixes) (i 1))
    (if (null? ps)
        name
        (loop (regexp-substitute/global #f (regexp-quote (car ps)) name
                                        'pre (format #f "\\x~2,'0x" i) 'post)
              (cdr ps) (1+ i)))))

(define (hex n) (string-upcase (number->string n 16)))

(display "//! Generated by tools/packs/names.scm from Guile's `char->formal-name`;
//! do not edit. [`PREFIXES`] stand in the names as the characters 1 to 13.

/// What the characters 1 to 13 of a name in [`BLOCKS`] stand for.
pub(crate) const PREFIXES: [&str; ")
(display (length prefixes))
(display "] = [\n")
(for-each (lambda (p) (format #t "    ~s,\n" p)) prefixes)
(display "];

/// First and last character, and each name between them in order after a
/// `|`; an empty name is a character Guile names none.
pub(crate) const BLOCKS: [(u32, u32, &str); ")
(display (length blocks))
(display "] = [\n")
(for-each
 (lambda (b)
   (format #t "    (\n        0x~a,\n        0x~a,\n        \"" (hex (car b)) (hex (cdr b)))
   (let loop ((c (car b)))
     (when (<= c (cdr b))
       (display "|")
       (display (packed (or (char->formal-name (integer->char c)) "")))
       (loop (1+ c))))
   (display "\",\n    ),\n"))
 blocks)
(display "];\n")
